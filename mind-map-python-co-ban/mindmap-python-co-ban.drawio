<mxfile><diagram name="Python co ban"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="root" value="Python cơ bản&lt;br&gt;(Lesson 01–05)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3a5f;fontColor=#ffffff;strokeColor=#1f3a5f;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="756" y="678" width="205" height="72" as="geometry"/></mxCell><mxCell id="l0" value="01. Giới thiệu Python" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="990" y="543" width="185" height="36" as="geometry"/></mxCell><mxCell id="el0" style="endArrow=none;curved=1;strokeColor=#6c8ebf;strokeWidth=3;" edge="1" parent="1" source="root" target="l0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l0_0" value="Ngôn ngữ bậc cao, thông dịch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1434" y="592" width="227" height="36" as="geometry"/></mxCell><mxCell id="el0_0" style="endArrow=none;curved=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="l0" target="l0_0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l0_1" value="Cú pháp ngắn gọn, khối lệnh bằng thụt lề" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1335" y="394" width="303" height="36" as="geometry"/></mxCell><mxCell id="el0_1" style="endArrow=none;curved=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="l0" target="l0_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l0_2" value="Ứng dụng: web, dữ liệu, AI, tự động hóa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1223" y="223" width="293" height="36" as="geometry"/></mxCell><mxCell id="el0_2" style="endArrow=none;curved=1;strokeColor=#6c8ebf